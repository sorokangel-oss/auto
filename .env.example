# 네이버 로그인 정보
NAVER_ID=
NAVER_PW=

# 네이버 블로그 아이디 (blog.naver.com/{여기})
NAVER_BLOG_ID=

# ---- 글쓰기 AI 인증 ----
# 기본값: 별도 설정 없이 이미 로그인된 Claude 구독(Pro/Max) 인증을 그대로 재사용합니다.
# 터미널에서 Claude Code에 로그인되어 있거나 `ant auth login`을 실행해두었다면
# 아래 ANTHROPIC_API_KEY 줄은 비워두거나(또는 주석 처리) 그대로 두세요.
#
# 구독 인증 대신 별도로 API 요금을 결제하는 방식을 쓰고 싶을 때만 아래 키를 채우세요.
# ANTHROPIC_API_KEY=

ANTHROPIC_MODEL=claude-opus-5
